NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_ENABLE_SIMULATOR=true
# Opcional: otro proveedor de tiles (por defecto Stadia Alidade Smooth). Ej. CARTO Positron con tu clave:
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?api_key=TU_CLAVE
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap &copy; CARTO

# Stellar Testnet (Hackathon). Nunca pongas llaves reales en este archivo.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Cuenta TILCA que recibe las comisiones. Genera un par con Keypair.random() y fondéala
# (npm run migrate:stellar la fondea con Friendbot si no existe).
NEXT_PUBLIC_STELLAR_PLATFORM_PUBLIC_KEY=G...
STELLAR_PLATFORM_SECRET=S...
# Cifra las llaves de los organizadores en la base. Genera una con: openssl rand -hex 32
STELLAR_ENCRYPTION_KEY=
TRUSTLESS_WORK_API_URL=https://api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=

# Importación de Superticket: correo de la cuenta (organizador "Cartelera TILCA") que revisa lo importado.
# En local, si falta, el importador crea cartelera@tilca.bo y muestra la contraseña una vez.
IMPORT_OWNER_EMAIL=
